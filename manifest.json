{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "Supersonique Studio SARL",
  "homepage_url": "https://github.com/mikecastrodemaria/Quill",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "images/icon-16px.png",
    "32": "images/icon-32px.png",
    "64": "images/icon-64px.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "images/icon-16px.png",
      "32": "images/icon-32px.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Q" },
      "description": "__MSG_actionTitle__"
    }
  },
  "permissions": ["sidePanel", "storage", "tabs", "activeTab", "scripting", "contextMenus"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://*.ai.cloud.ovh.net/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["<all_urls>"]
}
